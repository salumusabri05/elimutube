{
  "name": "elimutube-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "backend/api",
    "admin-web",
    "landing-web"
  ],
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "prisma": "^7.8.0"
  },
  "scripts": {
    "start:backend": "npm run start:dev --workspace=@elimutube/backend",
    "start:backend:prod": "npm run start:prod --workspace=@elimutube/backend",
    "build:backend": "npm run build --workspace=@elimutube/backend",
    "prisma:generate": "npm run generate --workspace=@elimutube/backend",
    "db:push": "npm run db:push --workspace=@elimutube/backend",
    "db:seed": "npm run db:seed --workspace=@elimutube/backend",
    "start:admin": "npm run dev --workspace=admin-web",
    "build:admin": "npm run build --workspace=admin-web",
    "start:landing": "npm run dev --workspace=landing-web",
    "build:landing": "npm run build --workspace=landing-web",
    "install:all": "npm install"
  }
}
